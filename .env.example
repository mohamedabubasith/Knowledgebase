DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=Admin@123
REDIS_URL=redis://redis:6379/0
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIMENSION=384
HF_HOME=/app/models
HF_TOKEN=
# LLM — OpenAI-compatible endpoint (NVIDIA NIM, Ollama, LM Studio, etc.)
TABULAR_SQL_BASE_URL=https://integrate.api.nvidia.com/v1
TABULAR_SQL_API_KEY=your-api-key
TABULAR_SQL_MODEL=openai/gpt-oss-120b
QDRANT_URL=https://your-qdrant-host:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=kb-documents
MINIO_USE_SSL=false
MAX_UPLOAD_SIZE_MB=100
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CORS_ORIGINS=["*"]
